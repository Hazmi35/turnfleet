{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>kakushindev/renovate-config", "docker:pinDigests"],
  "packageRules": [
    {
      "description": "controller-runtime, k8s.io/* and controller-tools must always move as one unit: a mismatch between the client libraries and the API server version breaks envtest and the generated CRDs.",
      "groupName": "kubernetes",
      "groupSlug": "kubernetes",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/controller-runtime/tools/setup-envtest",
        "sigs.k8s.io/controller-tools",
        "k8s.io/**"
      ]
    },
    {
      "description": "Lint toolchain lives in tools/go.mod as a `tool` directive.",
      "groupName": "golangci-lint toolchain",
      "matchManagers": ["gomod"],
      "matchFileNames": ["tools/go.mod"],
      "matchPackageNames": ["github.com/golangci/golangci-lint/v2"]
    },
    {
      "description": "Tool directives in the root module: bump them together with the pins in docs/versions.md, which the pull request template enforces.",
      "groupName": "go tools",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/elastic/crd-ref-docs",
        "golang.org/x/vuln",
        "github.com/google/licensecheck"
      ]
    },
    {
      "description": "The kind node image must stay on the same Kubernetes minor version as the envtest binaries; a major/minor bump is a deliberate change.",
      "groupName": "kind node image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["kindest/node"]
    },
    {
      "description": "coturn is the relay data plane; docs/versions.md pins it by tag and digest.",
      "groupName": "coturn",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["coturn/coturn"]
    },
    {
      "description": "ginkgo and gomega move together on a major bump.",
      "groupName": "test frameworks",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["github.com/onsi/ginkgo/v2", "github.com/onsi/gomega"]
    }
  ],
  "gomod": {
    "postUpdateOptions": ["gomodTidy"]
  },
  "customManagers": [
    {
      "description": "Pin the Go toolchain used by CI: GO_VERSION in .github/workflows.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["GO_VERSION: \"(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ]
}
