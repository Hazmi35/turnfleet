clusterrole.rbac.authorization.k8s.io/turnfleet-turnpool-viewer-role unchanged
rolebinding.rbac.authorization.k8s.io/turnfleet-leader-election-rolebinding unchanged
clusterrolebinding.rbac.authorization.k8s.io/turnfleet-manager-rolebinding unchanged
clusterrolebinding.rbac.authorization.k8s.io/turnfleet-metrics-auth-rolebinding unchanged
service/turnfleet-controller-manager-metrics-service unchanged
deployment.apps/turnfleet-controller-manager configured
